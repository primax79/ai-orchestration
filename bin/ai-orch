def _resolve_ui_broker_root() -> pathlib.Path | None:
    env_ui = os.environ.get("AI_ORCH_UI_ROOT")
    if env_ui and env_ui.strip():
        cand = pathlib.Path(env_ui).expanduser().resolve()
        if (cand / "backend" / "broker" / "shim.py").is_file():
            return cand
    for parent in [REPO_ROOT.parent, *REPO_ROOT.parents]:
        cand = parent / "ai-orchestration-ui"
        if (cand / "backend" / "broker" / "shim.py").is_file():
            return cand
    for cand in (
        pathlib.Path.home() / "works" / "ai-coding-tools" / "ai-orchestration-ui",
        pathlib.Path.home() / ".ai-orchestration" / "repos" / "ai-orchestration-ui",
    ):
        if (cand / "backend" / "broker" / "shim.py").is_file():
            return cand
    return None


def _run_ui_broker(subcommand: str, extra_args: list[str]) -> int:
    ui_root = _resolve_ui_broker_root()
    if ui_root is None:
        print("Error: sibling repo 'ai-orchestration-ui' with backend/broker not found.", file=sys.stderr)
        return 1
    venv_py = ui_root / ".venv" / "bin" / "python"
    py_exe = str(venv_py) if venv_py.is_file() else sys.executable
    env = os.environ.copy()
    env.setdefault("AI_ORCH_BIN", str(pathlib.Path(__file__).resolve()))
    proc = subprocess.run([py_exe, "-m", "backend.broker", subcommand, *extra_args], cwd=str(ui_root), env=env, check=False)
    return proc.returncode


def print_help() -> None:
    print(__doc__.strip())
    print("\nSubcommands:")
    for cmd_name, meta in CLI_DESCRIPTION["commands"].items():
        print(f"  {cmd_name:<18} {meta['description'] if 'description' in meta else meta['usage']}")


def main() -> int:
    os.environ.setdefault("AI_ORCH_BIN", str(pathlib.Path(__file__).resolve()))
    argv = sys.argv[1:]
    if not argv or argv[0] in ("-h", "--help", "help"):
        print_help()
        return 0

    top_json = False
    if argv[0] == "--json":
        top_json = True
        argv = argv[1:]

    if not argv:
        print_help()
        return 0

    group = argv[0]
    rest = argv[1:]
    if top_json and "--json" not in rest and group not in ("mcp",):
        rest = rest + ["--json"]

    if group == "describe":
        print(json.dumps(CLI_DESCRIPTION, indent=2))
        return 0

    if group == "install-launcher":
        proc = subprocess.run([sys.executable, str(ORCH_ENV_SCRIPT), "install-launcher", *rest], check=False)
        return proc.returncode

    if group == "mcp":
        if any(h in rest for h in ("-h", "--help", "help")):
            print("Usage: ai-orch mcp [--local] [--help]")
            print()
            print("Run the stdio MCP shim to the singleton broker, or serve broker MCP tools in-process over stdio when --local is passed.")
            print()
            print("Options:")
            print("  --local    Serve broker MCP tools in-process over stdio without starting a background broker process.")
            print("  -h, --help Show this help message and exit.")
            return 0
        if "--local" in rest:
            return _run_ui_broker("local", [r for r in rest if r != "--local"])
        return _run_ui_broker("shim", rest)

    if group == "setup":
        proc = subprocess.run([sys.executable, str(ORCH_CONFIG_SCRIPT), "setup", *rest], check=False)
        return proc.returncode

    if group == "config":
        proc = subprocess.run([sys.executable, str(ORCH_CONFIG_SCRIPT), *rest], check=False)
        return proc.returncode

    if group == "tasks":
        proc = subprocess.run([sys.executable, str(TASKS_ENGINE_SCRIPT), *rest], check=False)
        return proc.returncode

    if group == "questions":
        proc = subprocess.run([sys.executable, str(TASKS_ENGINE_SCRIPT), "questions", *rest], check=False)
        return proc.returncode

    if group == "use-cases":
        proc = subprocess.run([sys.executable, str(TASKS_ENGINE_SCRIPT), "use-cases", *rest], check=False)
        return proc.returncode

    if group == "inbox":
        proc = subprocess.run([sys.executable, str(TASKS_ENGINE_SCRIPT), "inbox", *rest], check=False)
        return proc.returncode

    if group == "feedback":
        proc = subprocess.run([sys.executable, str(TASKS_ENGINE_SCRIPT), "feedback", *rest], check=False)
        return proc.returncode

    if group == "env":
        proc = subprocess.run([sys.executable, str(ORCH_ENV_SCRIPT), *rest], check=False)
        return proc.returncode

    if group == "run":
        proc = subprocess.run([sys.executable, str(ORCH_RUNS_SCRIPT), *rest], check=False)
        return proc.returncode

    if group == "events":
        proc = subprocess.run([sys.executable, str(ORCH_EVENTS_SCRIPT), *rest], check=False)
        return proc.returncode

    if group in ("sessions", "session"):
        proc = subprocess.run([sys.executable, str(ORCH_SESSIONS_SCRIPT), *rest], check=False)
        return proc.returncode

    if group in ("triggers", "trigger"):
        proc = subprocess.run([sys.executable, str(ORCH_TRIGGERS_SCRIPT), *rest], check=False)
        return proc.returncode

    if group in ("orchestrator", "orch"):
        proc = subprocess.run([sys.executable, str(ORCH_ORCHESTRATOR_SCRIPT), *rest], check=False)
        return proc.returncode

    if group == "broker":
        if rest and rest[0] in ("serve", "shim"):
            return _run_ui_broker(rest[0], rest[1:])
        proc = subprocess.run([sys.executable, str(ORCH_BROKER_LOCK_SCRIPT), *rest], check=False)
        return proc.returncode

    if group in ("workspace", "workspaces"):
        if rest and rest[0] == "next":
            next_args = ["next", "--all-projects"]
            i = 1
            while i < len(rest):
                if rest[i] == "--root" and i + 1 < len(rest):
                    next_args.extend(["--workspace", rest[i + 1]])
                    i += 2
                else:
                    next_args.append(rest[i])
                    i += 1
            proc = subprocess.run([sys.executable, str(TASKS_ENGINE_SCRIPT), *next_args], check=False)
            return proc.returncode
        proc = subprocess.run([sys.executable, str(ORCH_REGISTRY_SCRIPT), "workspace", *rest], check=False)
        return proc.returncode

    if group in ("projects", "project"):
        proc = subprocess.run([sys.executable, str(ORCH_REGISTRY_SCRIPT), "projects", *rest], check=False)
        return proc.returncode

    if group == "render-agents-md":
        proc = subprocess.run([sys.executable, str(ORCH_CONFIG_SCRIPT), "render-agents-md", *rest], check=False)
        return proc.returncode

    print(f"Unknown command group: {group!r}. Run 'ai-orch --help' or 'ai-orch describe --json'.", file=sys.stderr)
    return 2


if __name__ == "__main__":
    sys.exit(main())
