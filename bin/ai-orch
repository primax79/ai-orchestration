        "render-agents-md": {
                    "usage": "ai-orch config render-agents-md [--workspace <dir>] [--apply | --check] [--json]",
                    "description": "Render or update the <!-- BEGIN ai-orchestration --> block in <workspace>/AGENTS.md.",
                },
            },
        },
        "tasks": {
            "script": str(TASKS_ENGINE_SCRIPT.relative_to(REPO_ROOT)),
            "usage": "ai-orch tasks <subcommand> [options] [--json]",
            "subcommands": {
                "list": {
                    "usage": "ai-orch tasks list [--tasks-dir <dir>] [--json]",
                    "description": "Parse all emergent tasks (active + done/) and initiatives into structured JSON.",
                },
                "validate": {
                    "usage": "ai-orch tasks validate [--tasks-dir <dir>] [--json]",
                    "description": "Validate unique IDs, closed header field order, states/priorities/profiles, DAG acyclicity, and required sections.",
                },
                "transition": {
                    "usage": (
                        "ai-orch tasks transition <task_id> <new_state> [--actor <actor>] "
                        "[--verifier <verifier>] [--reason <text>] [--tasks-dir <dir>] [--json]"
                    ),
                    "description": "Transition task state enforcing state-machine guards and moving closed tasks to tasks/done/.",
                },
