def print_help() -> None:
    print(__doc__.strip())
    print("\nSubcommands:")
    for cmd_name, meta in CLI_DESCRIPTION["commands"].items():
        print(f"  {cmd_name:<18} {meta['description'] if 'description' in meta else meta['usage']}")


def main() -> int:
    argv = sys.argv[1:]
    if not argv or argv[0] in ("-h", "--help", "help"):
        print_help()
        return 0

    top_json = False
    if argv[0] == "--json":
        top_json = True
        argv = argv[1:]

    if not argv:
        print_help()
        return 0

    group = argv[0]
    rest = argv[1:]
    if top_json and "--json" not in rest:
        rest = rest + ["--json"]

    if group == "describe":
        print(json.dumps(CLI_DESCRIPTION, indent=2))
        return 0

    if group == "config":
        proc = subprocess.run([sys.executable, str(ORCH_CONFIG_SCRIPT), *rest], check=False)
        return proc.returncode

    if group == "tasks":
        proc = subprocess.run([sys.executable, str(TASKS_ENGINE_SCRIPT), *rest], check=False)
        return proc.returncode

    if group == "questions":
        proc = subprocess.run([sys.executable, str(TASKS_ENGINE_SCRIPT), "questions", *rest], check=False)
        return proc.returncode

    if group == "use-cases":
        proc = subprocess.run([sys.executable, str(TASKS_ENGINE_SCRIPT), "use-cases", *rest], check=False)
        return proc.returncode

    if group == "inbox":
        proc = subprocess.run([sys.executable, str(TASKS_ENGINE_SCRIPT), "inbox", *rest], check=False)
        return proc.returncode

    if group == "env":
        proc = subprocess.run([sys.executable, str(ORCH_ENV_SCRIPT), *rest], check=False)
        return proc.returncode

    if group == "run":
        proc = subprocess.run([sys.executable, str(ORCH_RUNS_SCRIPT), *rest], check=False)
        return proc.returncode

    if group == "events":
        proc = subprocess.run([sys.executable, str(ORCH_EVENTS_SCRIPT), *rest], check=False)
        return proc.returncode

    if group in ("sessions", "session"):
        proc = subprocess.run([sys.executable, str(ORCH_SESSIONS_SCRIPT), *rest], check=False)
        return proc.returncode

    if group in ("triggers", "trigger"):
        proc = subprocess.run([sys.executable, str(ORCH_TRIGGERS_SCRIPT), *rest], check=False)
        return proc.returncode

    if group == "render-agents-md":
        proc = subprocess.run([sys.executable, str(ORCH_CONFIG_SCRIPT), "render-agents-md", *rest], check=False)
        return proc.returncode

    print(f"Unknown command group: {group!r}. Run 'ai-orch --help' or 'ai-orch describe --json'.", file=sys.stderr)
    return 2


if __name__ == "__main__":
    sys.exit(main())
