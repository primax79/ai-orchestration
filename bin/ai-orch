#!/usr/bin/env python3
"""ai-orch — Unified CLI entrypoint for `ai-orchestration`.

Dispatches:
  - `ai-orch config <subcommand> [args...]` -> `orchestration_config.py`
  - `ai-orch tasks <subcommand> [args...]`  -> `tasks_engine.py`
  - `ai-orch env <subcommand> [args...]`    -> `orchestration_env.py`
  - `ai-orch render-agents-md [args...]`    -> `orchestration_config.py render-agents-md`
  - `ai-orch describe [--json]`             -> machine-readable command & schema catalog
"""
from __future__ import annotations

import json
import pathlib
import subprocess
import sys
from typing import Any

REPO_ROOT = pathlib.Path(__file__).resolve().parent.parent
ORCH_CONFIG_SCRIPT = (
    REPO_ROOT
    / "plugins"
    / "shared"
    / "skills"
    / "orchestration-setup"
    / "scripts"
    / "orchestration_config.py"
)
TASKS_ENGINE_SCRIPT = (
    REPO_ROOT
    / "plugins"
    / "architect-side"
    / "skills"
    / "task-pipeline"
    / "scripts"
    / "tasks_engine.py"
)
ORCH_ENV_SCRIPT = REPO_ROOT / "scripts" / "orchestration_env.py"

CLI_DESCRIPTION: dict[str, Any] = {
    "name": "ai-orch",
    "version": "1.1.0",
    "repository": "https://github.com/primax79/ai-orchestration",
    "description": (
        "Unified CLI for ai-orchestration: manages Global/Project orchestration.toml, "
        "renders project AGENTS.md, and validates/transitions/syncs the tasks/ tree. "
        "Supports both Single-Framework Native setups (Kilo-only / Claude-only) and "
        "Multi-Framework MCP setups."
    ),
    "execution_modes": [
        {
            "id": "single-framework-native",
            "description": "Orchestrator == Executor (e.g. Kilo-only or Claude-only using native worktrees and subagents, zero MCP required; default verification: independent-session).",
        },
        {
            "id": "multi-framework-mcp",
            "description": "Orchestrator != Executor (cross-framework delegation and verification over MCP servers like kilo-mcp / claude-mcp or CLI; default verification: cross-agent or panel).",
        },
    ],
    "commands": {
        "describe": {
            "usage": "ai-orch describe [--json]",
            "description": "Return machine-readable JSON catalog of all ai-orch commands, arguments, and scripts.",
        },
        "config": {
            "script": str(ORCH_CONFIG_SCRIPT.relative_to(REPO_ROOT)),
            "usage": "ai-orch config <subcommand> [options] [--json]",
            "subcommands": {
                "show": {
                    "usage": "ai-orch config show [--workspace <dir>] [--global-config <file>] [--json]",
                    "description": "Load, merge, and display effective (Global + Project) orchestration.toml.",
                },
                "validate": {
                    "usage": "ai-orch config validate [--workspace <dir>] [--plugin-dir <dir>...] [--json]",
