                },
                "init-project": {
                    "usage": (
                        "ai-orch config init-project [--workspace <dir>] [--name <name>] "
                        "[--orchestrator <tool>] [--executor <tool>] "
                        "[--verification-mode <self|independent-session|cross-agent|panel|owner>] [--force] [--json]"
                    ),
                    "description": "Create <workspace>/tasks/orchestration.toml.",
                },
                "set-profile": {
                    "usage": (
                        "ai-orch config set-profile <tool> <profile> --model <id> "
                        "[--variant <v>] [--effort <e>] [--basis <b>] [--scope global|project] [--workspace <dir>] [--json]"
                    ),
                    "description": "Atomically set or update a (tool, profile) model assignment.",
                },
        "env": {
            "script": str(ORCH_ENV_SCRIPT.relative_to(REPO_ROOT)),
            "usage": "ai-orch env <subcommand> [options] [--json]",
            "subcommands": {
                "status": {
                    "usage": "ai-orch env status [--workspace <dir>] [--json]",
                    "description": "Verify status & drift of CLIs (kilo, claude, codex), installed skills, and MCP servers.",
                },
                "fetch-repos": {
                    "usage": "ai-orch env fetch-repos [--repos ai-orchestration kilo-mcp] [--json]",
                    "description": "Clone or update orchestration repositories into ~/.ai-orchestration/repos/.",
                },
                "install-skills": {
                    "usage": (
                        "ai-orch env install-skills [--assistants kilo claude codex | all] "
                        "[--scope global|project] [--repo ai-orchestration|kilo-mcp] [--link] [--workspace <dir>] [--json]"
                    ),
                    "description": "Install orchestration skills into Kilo, Claude, and/or Codex.",
                },
                "register-mcp": {
                    "usage": (
                        "ai-orch env register-mcp <kilo-mcp|claude-mcp|codex-mcp> "
                        "[--assistants kilo claude codex | all] [--scope global|project] [--provision-venv] [--json]"
                    ),
                    "description": "Provision and register an MCP server across assistants.",
                },
                "remove-skill": {
                    "usage": "ai-orch env remove-skill <skill_name> --assistant <kilo|claude|codex> [--scope global|project] [--json]",
