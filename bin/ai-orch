#!/usr/bin/env python3
"""ai-orch — Unified CLI entrypoint for `ai-orchestration`.

Dispatches:
  - `ai-orch config <subcommand> [args...]` -> `orchestration_config.py`
  - `ai-orch tasks <subcommand> [args...]`  -> `tasks_engine.py`
  - `ai-orch inbox <subcommand> [args...]`  -> `tasks_engine.py inbox`
  - `ai-orch env <subcommand> [args...]`    -> `orchestration_env.py`
  - `ai-orch run <subcommand> [args...]`    -> `orchestration_runs.py`
  - `ai-orch events <subcommand> [args...]` -> `orchestration_events.py`
  - `ai-orch sessions <subcommand> [args...]` -> `orchestration_sessions.py`
  - `ai-orch triggers <subcommand> [args...]` -> `orchestration_triggers.py`
  - `ai-orch render-agents-md [args...]`    -> `orchestration_config.py render-agents-md`
  - `ai-orch describe [--json]`             -> machine-readable command & schema catalog
"""
from __future__ import annotations

import json
import pathlib
import subprocess
import sys
from typing import Any

